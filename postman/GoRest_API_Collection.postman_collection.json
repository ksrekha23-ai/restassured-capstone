{
	"info": {
		"name": "GoRest API - Capstone Collection",
		"description": "Automated API test collection for GoRest API endpoints. Run requests in order using Collection Runner to execute the full CRUD workflow with chained variables.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://gorest.co.in/public/v2"
		},
		{
			"key": "token",
			"value": "YOUR_GOREST_TOKEN_HERE"
		},
		{
			"key": "userId",
			"value": ""
		},
		{
			"key": "postId",
			"value": ""
		},
		{
			"key": "commentId",
			"value": ""
		},
		{
			"key": "testEmail",
			"value": ""
		}
	],
	"item": [
		{
			"name": "User API",
			"item": [
				{
					"name": "1. Create User",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"var randomEmail = 'testuser_' + Date.now() + '@testmail.com';",
									"pm.collectionVariables.set('testEmail', randomEmail);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201 Created', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response has user id', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.collectionVariables.set('userId', jsonData.id);",
									"});",
									"",
									"pm.test('Name matches request', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql('Rekha Test User');",
									"});",
									"",
									"pm.test('Email matches request', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.email).to.eql(pm.collectionVariables.get('testEmail'));",
									"});",
									"",
									"pm.test('Gender is female', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.gender).to.eql('female');",
									"});",
									"",
									"pm.test('Status is active', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('active');",
									"});",
									"",
									"pm.test('Response time is under 3 seconds', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(3000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Rekha Test User\",\n    \"email\": \"{{testEmail}}\",\n    \"gender\": \"female\",\n    \"status\": \"active\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users",
							"host": ["{{baseUrl}}"],
							"path": ["users"]
						}
					}
				},
				{
					"name": "2. Get User by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 OK', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('User ID matches', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.eql(parseInt(pm.collectionVariables.get('userId')));",
									"});",
									"",
									"pm.test('User name is correct', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.name).to.eql('Rekha Test User');",
									"});",
									"",
									"pm.test('Response time is under 3 seconds', function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(3000);",
									"});"
								],
